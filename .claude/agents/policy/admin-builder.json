{
  "agent": "admin-builder",
  "level": "L2",
  "tools": ["Read", "Glob", "Grep", "Edit", "Write", "Bash", "TaskStop", "WebFetch"],
  "edit": {
    "allow": [
      "src/**",
      "public/**",
      "test/unit/admin.test.ts",
      "protected-drafts/wrangler.jsonc",
      "protected-drafts/test/wrangler.admin.jsonc"
    ],
    "deny": []
  },
  "bash": [
    ["npm", "test"],
    ["npx", "tsc", "--noEmit"],
    ["npx", "wrangler", "dev"],
    ["node", "--check", "re:^public/[a-z0-9-]+\\.js$"],
    ["git", "status"],
    ["git", "status", "--short"],
    ["git", "diff"],
    ["git", "diff", "--stat"],
    ["git", "branch", "--show-current"],
    ["git", "checkout", "-b", "re:^admin/[a-z0-9._-]+$"],
    ["git", "add", "re:^(src|public)/[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"],
    ["git", "add", "test/unit/admin.test.ts"],
    ["git", "add", "re:^protected-drafts/(wrangler\\.jsonc|test/wrangler\\.admin\\.jsonc)$"],
    ["git", "commit", "-m", "*"]
  ],
  "webfetch": ["developers.cloudflare.com", "developer.mozilla.org"]
}
