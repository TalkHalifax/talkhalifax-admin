{
  "name": "talkhalifax-admin",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p test",
    "test": "vitest run",
    "test:hooks": "node --test test/hooks/agent-guard.test.mjs test/hooks/agent-guard-worktrees.test.mjs test/hooks/promote-agent-drafts.test.mjs test/hooks/promote-protected-drafts.test.mjs",
    "test:e2e": "node test/e2e/admin.mjs",
    "check:contract": "tsc -p tsconfig.contract.json",
    "agents:promote": "node scripts/promote-agent-drafts.mjs",
    "drafts:promote": "node scripts/promote-protected-drafts.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@cloudflare/workers-types": "5.20261104.1",
    "puppeteer-core": "25.16.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}
